# SyncBridge dashboard frontend environment — copy to .env
# Base URL of the NestJS backend API.
VITE_API_BASE_URL=http://localhost:3001/api
# Stripe publishable key (test or live) — used by Stripe Elements in the browser.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# Origin of the marketing site (synkazo.com) — dashboard pages link out to it
# for pricing/terms/privacy/home.
VITE_MARKETING_URL=http://localhost:5183
