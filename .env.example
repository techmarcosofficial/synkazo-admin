# ⚠️  IF YOU RUN THIS APP VIA DOCKER (docker compose up --build), THIS FILE
# ⚠️  IS IGNORED. Docker builds VITE_* values from ../synkazo-docs/.env, not
# ⚠️  from here. Edit VITE_API_BASE_URL etc. in synkazo-docs/.env instead,
# ⚠️  then run `docker compose up -d --build` from synkazo-docs.
#
# This file only matters if you run `pnpm dev` / `vite build` directly on
# this machine, outside Docker. See
# synkazo-docs/docs/Admin_Environment_Variables.md for the full explanation.
#
# Synkazo dashboard frontend environment — copy to .env for local dev.

# Base URL of the Synkazo NestJS backend API.
VITE_API_BASE_URL=http://localhost:5002/api
# Native dev alternative:
# VITE_API_BASE_URL=http://localhost:3001/api

# Origin of the marketing site (synkazo.com) — dashboard pages link out to it
# for pricing / terms / privacy / home.
VITE_FRONTEND_URL=http://localhost:5001
# Native dev alternative:
# VITE_FRONTEND_URL=http://localhost:3000

# Stripe publishable key (test or live) — used by Stripe Elements in the browser.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
